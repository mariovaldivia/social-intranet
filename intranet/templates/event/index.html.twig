{% extends 'base.html.twig' %}

{% block title %}{{ (past ? 'event.list.past_title' : 'event.list.title')|trans }}{% endblock %}

{% block body %}
    <div class="flex items-center justify-between mb-2">
        <h1 class="text-2xl font-bold">{{ (past ? 'event.list.past_title' : 'event.list.title')|trans }}</h1>
        <a href="{{ path('app_event_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> {{ 'event.list.create'|trans }}
        </a>
    </div>

    <div class="mb-4 text-sm">
        {% if past %}
            <a href="{{ path('app_event_index') }}" class="link link-primary">
                <i class="bi bi-arrow-left"></i> {{ 'event.list.back_to_upcoming'|trans }}
            </a>
        {% else %}
            <a href="{{ path('app_event_past') }}" class="link link-primary">
                <i class="bi bi-clock-history"></i> {{ 'event.list.view_past'|trans }}
            </a>
        {% endif %}
    </div>

    {% for event in events %}
        <div class="card bg-base-100 shadow-sm mb-4">
            {# Clicking anywhere on the event (outside links and buttons) opens the comment box #}
            <div class="card-body post"
                {% if event.post %}
                    data-controller="comments"
                    data-comments-url-value="{{ path('post_comment', {'id': event.post.id}) }}"
                    data-action="click->comments#openFromPost"
                {% endif %}>
                {% include "timeline/_postEvent.html.twig" with {'event': event, 'actions': true} %}

                {% set post = event.post %}
                {% if post %}
                    {% include "timeline/_postActions.html.twig" with {'post': post} %}

                    {% include "timeline/_comments.html.twig" with {'post': post} %}
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">{{ (past ? 'event.list.empty_past' : 'event.list.empty_upcoming')|trans }}</div>
        </div>
    {% endfor %}
{% endblock %}

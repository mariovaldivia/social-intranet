{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.new.title'|trans }}{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold mb-4">{{ 'profile.new.heading'|trans }}</h1>

    <div class="card bg-base-100 shadow-sm max-w-2xl">
        <div class="card-body">
            {{ include('profile/_form.html.twig') }}
        </div>
    </div>

    <a href="{{ path('app_profile_index') }}" class="btn btn-ghost mt-4">
        <i class="bi bi-arrow-left"></i> {{ 'common.back_to_list'|trans }}
    </a>
{% endblock %}

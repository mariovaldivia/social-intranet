<form method="post" action="{{ path('app_profile_delete', {'id': profile.id}) }}" onsubmit="return confirm({{ 'common.delete_confirm'|trans|json_encode|e('html_attr') }});">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ profile.id) }}">
    <button class="btn btn-error btn-outline">{{ 'common.delete'|trans }}</button>
</form>

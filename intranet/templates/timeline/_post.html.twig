{% set user = post.user %}
{% set profile = user.profile %}
<div class="card bg-base-100 shadow-sm mb-4">
    {# Clicking anywhere on the post (outside links and buttons) opens the comment box #}
    <div class="card-body post"
        data-controller="comments"
        data-comments-url-value="{{ path('post_comment', {'id': post.id}) }}"
        data-action="click->comments#openFromPost">
        <div class="flex gap-3 items-center">
            <a href="{{ path('app_wall', {'username': user.username}) }}" class="shrink-0">
                {% include "_imageUser.html.twig" with {'user': user, 'size': 'user_post'} %}
            </a>

            <div>
                {% if user.username %}
                    <h4 class="font-semibold leading-tight">
                        <a href="{{ path('app_wall', {'username': user.username}) }}" class="hover:underline">
                            {{ user }}
                        </a>
                    </h4>
                {% else %}
                    {{ user }}
                {% endif %}

                {% if profile %}
                    <span class="text-sm opacity-70">
                        {{ profile.position }} - {{ profile.department }}
                    </span>
                {% endif %}
            </div>
        </div>

        <div class="mt-2">
            {% if post.message %}
                <p>{{ post.message }}</p>
            {% endif %}

            {% if post.event %}
                <h4 class="font-semibold mt-1">
                    <i class="bi bi-calendar2 mr-2"></i>
                    {{ post.event.date ? post.event.date|date('d/m/Y', false) : '' }}
                </h4>
                <p>{{ post.event.description|nl2br }}</p>
            {% endif %}
        </div>

        {% include "timeline/_postActions.html.twig" with {'post': post} %}

        {% include "timeline/_comments.html.twig" with {'post': post} %}
    </div>
</div>

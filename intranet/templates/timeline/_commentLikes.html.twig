{% set num_likes = likes|length %}

{% if num_likes > 0 %}
    <a href="{{ path('likes_comment', {'id': id}) }}"
        data-action="info-modal#open"
        class="badge badge-sm badge-soft badge-primary gap-1 hover:underline"
        title="{{ 'like.comment_title'|trans }}">
        <i class="bi bi-hand-thumbs-up-fill"></i>
        {{ num_likes }}
    </a>
{% endif %}

{% extends 'base.html.twig' %}

{% block title %}{{ 'gallery.title'|trans }}{% endblock %}

{% block body %}
    <div class="flex items-center justify-between mb-4">
        <h1 class="text-2xl font-bold">{{ 'gallery.title'|trans }}</h1>
        <a href="{{ path('app_gallery_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> {{ 'gallery.album.create'|trans }}
        </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {% for album in albums %}
            {% set cover = album.cover %}
            <a href="{{ path('app_gallery_show', {'id': album.id}) }}"
                class="album card bg-base-100 shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                <figure class="aspect-square bg-base-300">
                    {% if cover %}
                        <img src="{{ vich_uploader_asset(cover, 'imageFile')|imagine_filter('gallery_thumb') }}"
                            alt="{{ album.title }}"
                            class="w-full h-full object-cover"
                            loading="lazy">
                    {% else %}
                        <i class="bi bi-images text-5xl opacity-30"></i>
                    {% endif %}
                </figure>
                <div class="card-body p-3 gap-0.5">
                    <h2 class="font-semibold leading-tight line-clamp-2">{{ album.title }}</h2>
                    <p class="text-xs opacity-70">
                        {{ 'gallery.album.photo_count'|trans({count: album.photos|length}) }}
                        {% if album.eventDate %}
                            · {{ album.eventDate|date('d/m/Y', false) }}
                        {% endif %}
                    </p>
                </div>
            </a>
        {% else %}
            <div class="card bg-base-100 shadow-sm col-span-full">
                <div class="card-body items-center text-center">
                    <i class="bi bi-images text-4xl opacity-30"></i>
                    <p>{{ 'gallery.empty'|trans }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}

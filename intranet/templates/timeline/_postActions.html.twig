{# Returned by like_post: the replace controller swaps this whole element #}
{% set liked = post.hasLike(app.user) %}
<div class="post-actions flex items-center gap-1 mt-2" data-controller="replace">
    <a href="{{ path('like_post', {'id': post.id}) }}"
        data-action="replace#load"
        aria-pressed="{{ liked ? 'true' : 'false' }}"
        class="post-like btn btn-ghost btn-xs gap-1 px-2 transition-transform active:scale-95 {{ liked ? 'text-primary' : 'text-base-content/70' }}">
        <i class="bi {{ liked ? 'bi-hand-thumbs-up-fill' : 'bi-hand-thumbs-up' }}"></i>
        {{ 'like.action'|trans }}
    </a>

    <a href="{{ path('post_comment', {'id': post.id}) }}"
        data-action="comments#open"
        class="add-comment btn btn-ghost btn-xs gap-1 px-2 text-base-content/70 transition-transform active:scale-95">
        <i class="bi bi-chat"></i>
        {{ 'post.comment'|trans }}
    </a>

    <div class="ml-auto">
        {% include "timeline/_likes.html.twig" with {'likes': post.likes, 'id': post.id} %}
    </div>
</div>

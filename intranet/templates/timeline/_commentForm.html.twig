{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'flex gap-2 items-start mt-3'}}) }}
    {% if app.user %}
        <div class="shrink-0 mt-0.5">
            {% include "_imageUser.html.twig" with {'user': app.user, 'size': 'user_comment'} %}
        </div>
    {% endif %}

    <div class="flex-1 min-w-0">
        <div class="flex items-end gap-1 bg-base-200 rounded-2xl pl-3 pr-1 py-1 focus-within:ring-2 focus-within:ring-primary/30">
            {# Enter submits, Shift+Enter adds a line break (see app.js) #}
            {{ form_widget(form.message, {'attr': {
                'class': 'bg-transparent border-0 shadow-none outline-none focus:outline-none px-0 py-1 min-h-0 resize-none field-sizing-content max-h-40 text-sm',
                'rows': 1,
                'placeholder': 'Write a comment...'
            }}) }}
            <button class="btn btn-ghost btn-circle btn-sm text-primary" aria-label="Send comment">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
        {{ form_errors(form.message) }}
    </div>
{{ form_end(form) }}

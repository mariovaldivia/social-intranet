{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <div class="card bg-base-100 shadow-sm max-w-md mx-auto mt-8">
        <div class="card-body">
            <form method="post">
                {% if error %}
                    <div role="alert" class="alert alert-error alert-soft mb-4">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        You are logged in as {{ app.user.userIdentifier }},
                        <a href="{{ path('app_logout') }}" class="link">
                            Logout
                        </a>
                    </div>
                {% endif %}

                <h1 class="text-2xl font-bold mb-2">Please sign in</h1>

                <fieldset class="fieldset">
                    <label for="username" class="fieldset-legend">Email</label>
                    <input type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="username"
                        class="input w-full"
                        autocomplete="email"
                        required
                        autofocus>
                </fieldset>

                <fieldset class="fieldset">
                    <label for="password" class="fieldset-legend">Password</label>
                    <input type="password"
                        name="_password"
                        id="password"
                        class="input w-full"
                        autocomplete="current-password"
                        required>
                </fieldset>

                <input type="hidden" name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >

                {#
                    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                    See https://symfony.com/doc/current/security/remember_me.html

                    <label class="label mt-2">
                        <input type="checkbox" name="_remember_me" class="checkbox"> Remember me
                    </label>
                #}

                <button class="btn btn-primary w-full mt-4" type="submit">
                    Sign in
                </button>
            </form>
        </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Employees{% endblock %}

{% block body %}
    <div class="flex items-center justify-between mb-4">
        <h1 class="text-2xl font-bold">Employees</h1>
        <a href="{{ path('app_profile_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Create new
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {% for profile in profiles %}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body flex-row items-center gap-4">
                <div class="shrink-0">
                    {% include "_imageUser.html.twig" with {'user': profile.user, 'size': 'user_post'} %}
                </div>

                <div class="min-w-0">
                    <h4 class="font-semibold text-lg">
                        {% if profile.user %}
                            <a href="{{ path('app_wall', {'username': profile.user.username}) }}" class="link link-hover">{{ profile }}</a>
                        {% else %}
                            {{ profile }}
                        {% endif %}
                    </h4>
                    <p class="text-sm opacity-70">{{ profile.position }} - {{ profile.department }}</p>

                    <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm mt-2">
                        <span>
                            <i class="bi bi-envelope mr-1"></i>
                            {{ profile.user ? profile.user.email : profile.email }}
                        </span>
                        {% if profile.phone %}
                            <span>
                                <i class="bi bi-telephone mr-1"></i>
                                {{ profile.phone }}
                            </span>
                        {% endif %}
                        {% if profile.birthDate %}
                            <span>
                                <i class="bi bi-gift mr-1"></i>
                                {{ profile.birthDate|date('d M') }}
                            </span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">No records found</div>
        </div>
    {% endfor %}
    </div>
{% endblock %}

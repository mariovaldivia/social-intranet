<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'app.default_title'|trans }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}
    </head>

    <body class="bg-base-200 min-h-screen" data-controller="info-modal"
          data-info-modal-error-value="{{ 'common.load_error'|trans }}">
    <div class="drawer drawer-end">
        <input id="user-drawer" type="checkbox" class="drawer-toggle">

        <div class="drawer-content">
            <nav class="navbar bg-primary text-primary-content shadow-sm">
                <div class="flex-1 gap-2">
                    <a class="btn btn-ghost text-xl" href="{{ path('app_timeline') }}">{{ 'app.brand'|trans }}</a>
                    <a class="btn btn-ghost btn-sm hidden sm:inline-flex" href="{{ path('app_event_index') }}">{{ 'nav.events'|trans }}</a>
                    <a class="btn btn-ghost btn-sm hidden sm:inline-flex" href="{{ path('app_gallery_index') }}">{{ 'nav.gallery'|trans }}</a>
                </div>
                {% if app.user %}
                    <label for="user-drawer" class="btn btn-ghost btn-square" aria-label="{{ 'nav.open_user_menu'|trans }}">
                        <i class="bi bi-list text-2xl"></i>
                    </label>
                {% endif %}
            </nav>

            <main class="container mx-auto max-w-6xl px-4 py-4">
                {% block body %}{% endblock %}
            </main>
        </div>

        {% if app.user %}
            {% set profile = app.user.profile %}
            <div class="drawer-side z-20">
                <label for="user-drawer" class="drawer-overlay" aria-label="{{ 'nav.close_user_menu'|trans }}"></label>
                <div class="bg-base-100 min-h-full w-80 p-4">
                    <div class="flex items-center justify-between mb-4">
                        <h5 class="text-lg font-semibold">{{ 'app.name'|trans }}</h5>
                        <label for="user-drawer" class="btn btn-sm btn-circle btn-ghost" aria-label="{{ 'common.close'|trans }}">
                            <i class="bi bi-x-lg"></i>
                        </label>
                    </div>

                    <div class="flex gap-4 items-center">
                        {% if profile.imageName %}
                            <img src="{{ vich_uploader_asset(profile, 'imageFile')|imagine_filter('user') }}"
                                class="rounded-full w-24 h-24"
                                title="{{ profile }}">
                        {% else %}
                            <img src="{{ 'images/user-default.jpg'|imagine_filter('user') }}"
                                class="rounded-full w-24 h-24">
                        {% endif %}

                        <div>
                            <h3 class="text-xl font-semibold">{{ profile }}</h3>
                            <p class="text-sm opacity-70">{{ profile.position }}<br>{{ profile.department }}</p>
                        </div>
                    </div>

                    <a class="btn btn-outline btn-primary btn-sm mt-4" href="{{ path('app_logout') }}">
                        <i class="bi bi-box-arrow-right"></i> {{ 'nav.logout'|trans }}
                    </a>

                    <ul class="menu w-full mt-4 px-0">
                        <li><a href="{{ path('app_timeline') }}"><i class="bi bi-house"></i> {{ 'nav.timeline'|trans }}</a></li>
                        <li><a href="{{ path('app_event_index') }}"><i class="bi bi-calendar2"></i> {{ 'nav.events'|trans }}</a></li>
                        <li><a href="{{ path('app_profile_index') }}"><i class="bi bi-people"></i> {{ 'nav.employees'|trans }}</a></li>
                        <li><a href="{{ path('app_gallery_index') }}"><i class="bi bi-images"></i> {{ 'nav.gallery'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        {% endif %}
    </div>

    <dialog id="info-modal" class="modal" data-info-modal-target="dialog">
        <div class="modal-box">
            <form method="dialog">
                <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="{{ 'common.close'|trans }}">
                    <i class="bi bi-x-lg"></i>
                </button>
            </form>
            <h3 class="modal-title text-lg font-bold mb-3" data-info-modal-target="title"></h3>
            <div class="modal-body" data-info-modal-target="body"></div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>{{ 'common.close'|trans }}</button>
        </form>
    </dialog>

    </body>
</html>

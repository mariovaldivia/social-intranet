{% extends 'base.html.twig' %}

{% block title %}{{ 'app.name'|trans }}{% endblock %}

{% block body %}

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="md:col-span-2">
        <div class="card bg-base-100 shadow-sm mb-4">
            <div class="card-body">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    {% include "timeline/_messageBox.html.twig" with {
                        'field': form.message,
                        'placeholder': 'timeline.post_placeholder'|trans,
                        'submit_label': 'timeline.publish'|trans,
                        'large': true,
                    } %}
                {{ form_end(form) }}
            </div>
        </div>

        {% for post in posts %}
            {% include "timeline/_post.html.twig" with {'post': post} %}
        {% else %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body">{{ 'timeline.no_posts'|trans }}</div>
            </div>
        {% endfor %}
    </div>

    <div class="flex flex-col gap-4">
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-base">
                    <i class="bi bi-gift"></i> {{ 'timeline.birthdays.title'|trans }}
                </h2>
                {% for profile in birthdays %}
                    <div class="flex gap-3 items-center">
                        {% include "_imageUser.html.twig" with {'user': profile.user, 'size': 'user_post'} %}
                        <div>
                            {{ profile }}<br>
                            <span class="text-sm opacity-70">
                                <i class="bi bi-calendar3 mr-1"></i> {{ profile.birthDate|date('d M', false) }}
                            </span>
                        </div>
                    </div>
                {% else %}
                    <p class="text-sm opacity-70">{{ 'timeline.birthdays.empty'|trans }}</p>
                {% endfor %}
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-base">
                    <i class="bi bi-person-plus"></i> {{ 'timeline.new_hires.title'|trans }}
                </h2>
                {% for profile in newHires %}
                    <div class="flex gap-3 items-center new-hire">
                        {% include "_imageUser.html.twig" with {'user': profile.user, 'size': 'user_post'} %}
                        <div class="min-w-0">
                            {% if profile.user %}
                                <a href="{{ path('app_wall', {'username': profile.user.username}) }}" class="font-semibold hover:underline">{{ profile }}</a>
                            {% else %}
                                <span class="font-semibold">{{ profile }}</span>
                            {% endif %}
                            {% if profile.position or profile.department %}
                                <div class="text-sm opacity-70 truncate">
                                    {{ profile.position }}{{ profile.position and profile.department ? ' · ' }}{{ profile.department }}
                                </div>
                            {% endif %}
                            <div class="text-sm opacity-70">
                                <i class="bi bi-door-open mr-1"></i> {{ 'profile.joined'|trans({date: profile.hireDate|date('d M Y', false)}) }}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-sm opacity-70">{{ 'timeline.new_hires.empty'|trans }}</p>
                {% endfor %}
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-base">
                    <i class="bi bi-calendar2"></i> {{ 'timeline.events.title'|trans }}
                </h2>
                {% for event in events %}
                    <div class="flex gap-3">
                        <i class="bi bi-calendar3"></i>
                        <div>
                            <span class="font-semibold">{{ event.date|date('d/M', false) }}</span><br>
                            {{ event.description }}
                        </div>
                    </div>
                {% else %}
                    <p class="text-sm opacity-70">{{ 'timeline.events.empty'|trans }}</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{% endblock %}

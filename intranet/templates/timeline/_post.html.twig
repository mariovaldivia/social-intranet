{% set user = post.user %}
{% set profile = user.profile %}
<div class="card bg-base-100 shadow-sm mb-4">
    {# Clicking anywhere on the post (outside links and buttons) opens the comment box #}
    <div class="card-body post"
        data-controller="comments"
        data-comments-url-value="{{ path('post_comment', {'id': post.id}) }}"
        data-action="click->comments#openFromPost">
        <div class="flex gap-3 items-center">
            <a href="{{ path('app_wall', {'username': user.username}) }}" class="shrink-0">
                {% include "_imageUser.html.twig" with {'user': user, 'size': 'user_post'} %}
            </a>

            <div>
                <div class="flex flex-wrap items-baseline gap-x-2">
                    {% if user.username %}
                        <h4 class="font-semibold leading-tight">
                            <a href="{{ path('app_wall', {'username': user.username}) }}" class="hover:underline">
                                {{ user }}
                            </a>
                        </h4>
                    {% else %}
                        <span class="font-semibold">{{ user }}</span>
                    {% endif %}
                    {% if post.date %}
                        {# "5 minutes ago"; a week or older shows the date (time_ago filter) #}
                        <time class="post-date text-xs opacity-60"
                            datetime="{{ post.date|date('c') }}"
                            title="{{ post.date|date('d/m/Y H:i') }}">
                            {{ post.date|time_ago }}
                        </time>
                    {% endif %}
                </div>

                {% if profile %}
                    <span class="text-sm opacity-70">
                        {{ profile.position }} - {{ profile.department }}
                    </span>
                {% endif %}
            </div>
        </div>

        <div class="mt-3 space-y-3">
            {% if post.message %}
                <p class="post-message whitespace-pre-line break-words leading-relaxed">{{ post.message }}</p>
            {% endif %}

            {% if post.event %}
                {% include "timeline/_postEvent.html.twig" with {'event': post.event} %}
            {% endif %}

            {% if post.album %}
                {% include "timeline/_postAlbum.html.twig" with {'post': post} %}
            {% endif %}
        </div>

        {% include "timeline/_postActions.html.twig" with {'post': post} %}

        {% include "timeline/_comments.html.twig" with {'post': post} %}
    </div>
</div>

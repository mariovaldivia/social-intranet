{% set num_likes = likes|length %}

{% if num_likes > 0 %}
    <a href="{{ path('likes_comment', {'id': id}) }}"
        data-info-modal
        class="link link-hover"
        title="People who likes this comment">
        <i class="bi bi-hand-thumbs-up mr-1"></i>
        {{ num_likes }}
    </a>
{% endif %}

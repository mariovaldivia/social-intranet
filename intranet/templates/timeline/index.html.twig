{% extends 'base.html.twig' %}

{% block title %}Social Intranet{% endblock %}

{% block body %}

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="md:col-span-2">
        <div class="card bg-base-100 shadow-sm mb-4">
            <div class="card-body">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    {% include "timeline/_messageBox.html.twig" with {
                        'field': form.message,
                        'placeholder': "What's on your mind?",
                        'submit_label': 'Publish',
                        'large': true,
                    } %}
                {{ form_end(form) }}
            </div>
        </div>

        {% for post in posts %}
            {% include "timeline/_post.html.twig" with {'post': post} %}
        {% else %}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body">No posts</div>
            </div>
        {% endfor %}
    </div>

    <div class="flex flex-col gap-4">
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-base">
                    <i class="bi bi-gift"></i> Upcoming birthdays
                </h2>
                {% for profile in birthdays %}
                    <div class="flex gap-3 items-center">
                        {% include "_imageUser.html.twig" with {'user': profile.user, 'size': 'user_post'} %}
                        <div>
                            {{ profile }}<br>
                            <span class="text-sm opacity-70">
                                <i class="bi bi-calendar3 mr-1"></i> {{ profile.birthDate|date('d M') }}
                            </span>
                        </div>
                    </div>
                {% else %}
                    <p class="text-sm opacity-70">No upcoming birthdays</p>
                {% endfor %}
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-base">
                    <i class="bi bi-calendar2"></i> Upcoming Events
                </h2>
                {% for event in events %}
                    <div class="flex gap-3">
                        <i class="bi bi-calendar3"></i>
                        <div>
                            <span class="font-semibold">{{ event.date|date('d/M') }}</span><br>
                            {{ event.description }}
                        </div>
                    </div>
                {% else %}
                    <p class="text-sm opacity-70">No upcoming events</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{% endblock %}

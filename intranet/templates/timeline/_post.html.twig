{% set user = post.user %}
{% set profile = user.profile %}
{# app.js replaces this root element when the post is liked: keep .post as its direct child #}
<div class="card bg-base-100 shadow-sm mb-4">
    <div class="card-body post">
        <div class="flex gap-3 items-center">
            <a href="{{ path('app_wall', {'username': user.username}) }}" class="shrink-0">
                {% include "_imageUser.html.twig" with {'user': user, 'size': 'user_post'} %}
            </a>

            <div>
                {% if user.username %}
                    <h4 class="font-semibold leading-tight">
                        <a href="{{ path('app_wall', {'username': user.username}) }}" class="hover:underline">
                            {{ user }}
                        </a>
                    </h4>
                {% else %}
                    {{ user }}
                {% endif %}

                {% if profile %}
                    <span class="text-sm opacity-70">
                        {{ profile.position }} - {{ profile.department }}
                    </span>
                {% endif %}
            </div>
        </div>

        <div class="mt-2">
            {% if post.message %}
                <p>{{ post.message }}</p>
            {% endif %}

            {% if post.event %}
                <h4 class="font-semibold mt-1">
                    <i class="bi bi-calendar2 mr-2"></i>
                    {{ post.event.date ? post.event.date|date('d/m/Y') : '' }}
                </h4>
                <p>{{ post.event.description|nl2br }}</p>
            {% endif %}
        </div>

        {% include "timeline/_likes.html.twig" with {'likes': post.likes, 'id': post.id} %}

        <div class="grid grid-cols-2 gap-2 mt-1">
            <a href="{{ path('like_post', {'id': post.id}) }}"
                class="post-like btn btn-sm {{ post.hasLike(app.user) ? 'btn-primary btn-soft' : 'btn-ghost' }}">
                <i class="bi bi-hand-thumbs-up"></i>
                Like
            </a>

            <a href="{{ path('post_comment', {'id': post.id}) }}" class="add-comment btn btn-sm btn-ghost">
                <i class="bi bi-chat"></i>
                Comment
            </a>
        </div>

        <div class="comment-form"></div>

        <div class="comments">
            {% for comment in post.comments %}
                {% include "timeline/_commentItem.html.twig" with {'comment': comment} %}
            {% endfor %}
        </div>
    </div>
</div>

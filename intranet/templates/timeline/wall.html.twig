{% extends 'base.html.twig' %}

{% block title %}{{ user.profile ? user.profile : 'User is not registered'}}{% endblock %}

{% block body %}
    {% if user.profile %}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body flex-row items-center gap-4">
                {% include "_imageUser.html.twig" with {'user': user, 'size': 'user'} %}

                <div>
                    <h2 class="text-2xl font-bold">{{ user.profile }}</h2>
                    <h4 class="text-lg opacity-70">{{ user.profile.position }} - {{ user.profile.department }}</h4>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
        <div>
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body gap-3">
                    <p>
                        <i class="bi bi-envelope mr-2"></i>
                        {{ user.email }}
                    </p>

                    {% if user.profile %}
                        <p>
                            <i class="bi bi-telephone mr-2"></i> {{ user.profile.phone }}
                        </p>

                        <p>
                            <i class="bi bi-gift mr-2"></i> {{ user.profile.birthDate|date('d M') }}
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="md:col-span-2">
            {% for post in posts %}
                {% include "timeline/_post.html.twig" with {'post': post} %}
            {% else %}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body">No posts</div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

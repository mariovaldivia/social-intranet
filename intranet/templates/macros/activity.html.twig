{# Shared look of site activities (My activities, planning calendar).
   Usage: {% import 'macros/activity.html.twig' as activity_ui %} #}

{# Bootstrap Icons class for an App\Enum\ActivityType #}
{% macro type_icon(type) -%}
    {{ {
        'technical_visit': 'bi-clipboard-check',
        'maintenance': 'bi-tools',
        'installation': 'bi-box-seam',
        'repair': 'bi-wrench',
        'inspection': 'bi-search',
        'emergency': 'bi-exclamation-triangle',
        'training': 'bi-mortarboard',
        'other': 'bi-three-dots',
    }[type.value] ?? 'bi-three-dots' }}
{%- endmacro %}

{# daisyUI badge classes for an App\Enum\ActivityStatus #}
{% macro status_badge(status) -%}
    {{ {
        'scheduled': 'badge-info badge-soft',
        'in_progress': 'badge-warning badge-soft',
        'completed': 'badge-success badge-soft',
        'cancelled': 'badge-ghost',
        'not_done': 'badge-error badge-soft',
    }[status.value] ?? 'badge-ghost' }}
{%- endmacro %}

{# Calendar entry colors for an App\Enum\ActivityStatus: tinted background
   (text stays readable) plus a left border of the same color #}
{% macro status_chip(status) -%}
    {{ {
        'scheduled': 'bg-info/15 hover:bg-info/25 border-info',
        'in_progress': 'bg-warning/20 hover:bg-warning/30 border-warning',
        'completed': 'bg-success/15 hover:bg-success/25 border-success',
        'cancelled': 'bg-base-200 hover:bg-base-300 border-base-300 line-through opacity-60',
        'not_done': 'bg-error/15 hover:bg-error/25 border-error',
    }[status.value] ?? 'bg-base-200 hover:bg-base-300 border-base-300' }}
{%- endmacro %}

<ul class="list">
{% for like in likes %}
    <li class="list-row p-2">
        <a href="{{ path('app_wall', {'username': like.user.username}) }}" class="flex gap-3 items-center w-full hover:bg-base-200 rounded-box p-1">
            {% include "_imageUser.html.twig" with {'user': like.user, 'size': 'user_post'} %}
            <div>
                <div class="font-semibold">{{ like.user }}</div>
                <div class="text-sm opacity-70">{{ like.user.profile.position }} - {{ like.user.profile.department }}</div>
            </div>
        </a>
    </li>
{% endfor %}
</ul>

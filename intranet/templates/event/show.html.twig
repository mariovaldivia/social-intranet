{% extends 'base.html.twig' %}

{% block title %}{{ 'event.show.title'|trans }}{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold mb-4">{{ 'event.show.title'|trans }}</h1>

    <div class="card bg-base-100 shadow-sm max-w-2xl">
        <div class="card-body">
            <table class="table">
                <tbody>
                    <tr>
                        <th>{{ 'common.id'|trans }}</th>
                        <td>{{ event.id }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'event.field.description'|trans }}</th>
                        <td>{{ event.description }}</td>
                    </tr>
                    <tr>
                        <th>{{ 'event.field.date'|trans }}</th>
                        <td>{{ event.date ? event.date|date('Y-m-d', false) : '' }}</td>
                    </tr>
                </tbody>
            </table>

            <div class="card-actions mt-2">
                <a href="{{ path('app_event_index') }}" class="btn btn-ghost">
                    <i class="bi bi-arrow-left"></i> {{ 'common.back_to_list'|trans }}
                </a>
                <a href="{{ path('app_event_edit', {'id': event.id}) }}" class="btn btn-primary">{{ 'common.edit'|trans }}</a>
                {{ include('event/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}

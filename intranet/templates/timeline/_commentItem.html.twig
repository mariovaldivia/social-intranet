{# Returned by like_comment and post_comment: the replace controller swaps this whole element on like #}
<div class="comment flex gap-2 mt-3" data-controller="replace">
    <a href="{{ path('app_wall', {'username': comment.user.username}) }}" class="shrink-0 mt-0.5">
        {% include "_imageUser.html.twig" with {'user': comment.user, 'size': 'user_comment'} %}
    </a>

    <div class="min-w-0 flex-1">
        <div class="bg-base-200 rounded-2xl px-3 py-2">
            <div class="flex flex-wrap items-baseline gap-x-2">
                <a href="{{ path('app_wall', {'username': comment.user.username}) }}" class="text-sm font-semibold hover:underline">
                    {{ comment.user }}
                </a>
                <time class="text-xs opacity-60"
                    datetime="{{ comment.date|date('c') }}"
                    title="{{ comment.date|date('d/m/Y H:i') }}">
                    {{ comment.date|time_ago }}
                </time>
            </div>
            <p class="text-sm whitespace-pre-line break-words">{{ comment.message }}</p>
        </div>

        <div class="flex items-center gap-3 text-xs mt-1 pl-3">
            {% set liked = comment.hasLike(app.user) %}
            <a href="{{ path('like_comment', {'id': comment.id}) }}"
                data-action="replace#load"
                aria-pressed="{{ liked ? 'true' : 'false' }}"
                class="comment-like inline-flex items-center gap-1 font-semibold hover:underline transition-transform active:scale-95 {{ liked ? 'text-primary' : 'text-base-content/60' }}">
                <i class="bi {{ liked ? 'bi-hand-thumbs-up-fill' : 'bi-hand-thumbs-up' }}"></i>
                {{ 'like.action'|trans }}
            </a>
            {% include "timeline/_commentLikes.html.twig" with {'likes': comment.likes, 'id': comment.id} %}
        </div>
    </div>
</div>

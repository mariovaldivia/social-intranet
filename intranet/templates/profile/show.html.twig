{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold mb-4">Profile</h1>

    <div class="card bg-base-100 shadow-sm max-w-2xl">
        <div class="card-body">
            <table class="table">
                <tbody>
                    <tr>
                        <th>Id</th>
                        <td>{{ profile.id }}</td>
                    </tr>
                    <tr>
                        <th>Name</th>
                        <td>{{ profile.name }}</td>
                    </tr>
                    <tr>
                        <th>Position</th>
                        <td>{{ profile.position }}</td>
                    </tr>
                    <tr>
                        <th>Birthdate</th>
                        <td>{{ profile.birthdate ? profile.birthdate|date('Y-m-d') : '' }}</td>
                    </tr>
                    <tr>
                        <th>Phone</th>
                        <td>{{ profile.phone }}</td>
                    </tr>
                    <tr>
                        <th>LastName</th>
                        <td>{{ profile.lastName }}</td>
                    </tr>
                    <tr>
                        <th>Identification</th>
                        <td>{{ profile.identification }}</td>
                    </tr>
                    <tr>
                        <th>ImageName</th>
                        <td>{{ profile.imageName }}</td>
                    </tr>
                    <tr>
                        <th>ImageSize</th>
                        <td>{{ profile.imageSize }}</td>
                    </tr>
                    <tr>
                        <th>UpdatedAt</th>
                        <td>{{ profile.updatedAt ? profile.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                    </tr>
                </tbody>
            </table>

            <div class="card-actions mt-2">
                <a href="{{ path('app_profile_index') }}" class="btn btn-ghost">
                    <i class="bi bi-arrow-left"></i> back to list
                </a>
                <a href="{{ path('app_profile_edit', {'id': profile.id}) }}" class="btn btn-primary">edit</a>
                {{ include('profile/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}

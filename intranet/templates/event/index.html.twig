{% extends 'base.html.twig' %}

{% block title %}Events{% endblock %}

{% block body %}
    <div class="flex items-center justify-between mb-4">
        <h1 class="text-2xl font-bold">Events</h1>
        <a href="{{ path('app_event_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Create event
        </a>
    </div>

    {% for event in events %}
        <div class="card bg-base-100 shadow-sm mb-4">
            <div class="card-body post">
                <div class="flex items-start justify-between gap-2">
                    <h4 class="card-title">
                        <i class="bi bi-calendar2"></i>
                        {{ event.date ? event.date|date('d/m/Y') : '' }}
                    </h4>
                    <div class="flex gap-1">
                        <a href="{{ path('app_event_show', {'id': event.id}) }}" class="btn btn-ghost btn-xs">show</a>
                        <a href="{{ path('app_event_edit', {'id': event.id}) }}" class="btn btn-ghost btn-xs">edit</a>
                    </div>
                </div>

                <p>{{ event.description|nl2br }}</p>

                {% set post = event.post %}
                {% if post %}
                    {% include "timeline/_likes.html.twig" with {'likes': post.likes, 'id': post.id} %}

                    <div class="grid grid-cols-2 gap-2 mt-1">
                        <a href="{{ path('like_post', {'id': post.id}) }}" class="btn btn-sm btn-ghost">
                            <i class="bi bi-hand-thumbs-up"></i>
                            Like
                        </a>

                        <a href="{{ path('post_comment', {'id': post.id}) }}" class="add-comment btn btn-sm btn-ghost">
                            <i class="bi bi-chat"></i>
                            Comment
                        </a>
                    </div>

                    <div class="comment-form"></div>

                    <div class="comments">
                        {% for comment in post.comments %}
                            {% include "timeline/_commentItem.html.twig" with {'comment': comment} %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">No events found</div>
        </div>
    {% endfor %}
{% endblock %}

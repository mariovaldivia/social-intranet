{# Pill-shaped message input with the current user's avatar, shared by the
   post and comment forms. Enter submits, Shift+Enter adds a line break
   (submit-on-enter controller).

   Parameters: field (the form's message field), placeholder, submit_label,
   large (bigger avatar and text, for new posts) #}
{% set large = large|default(false) %}
<div class="flex {{ large ? 'gap-3' : 'gap-2' }} items-start">
    {% if app.user %}
        <div class="shrink-0 mt-0.5">
            {% include "_imageUser.html.twig" with {'user': app.user, 'size': large ? 'user_post' : 'user_comment'} %}
        </div>
    {% endif %}

    <div class="flex-1 min-w-0">
        <div class="flex items-end gap-1 bg-base-200 rounded-3xl {{ large ? 'pl-4 pr-1.5 py-1.5' : 'pl-3 pr-1 py-1' }} focus-within:ring-2 focus-within:ring-primary/30">
            {{ form_widget(field, {'attr': {
                'class': 'bg-transparent border-0 shadow-none outline-none focus:outline-none px-0 py-1 min-h-0 resize-none field-sizing-content ' ~ (large ? 'max-h-60' : 'max-h-40 text-sm'),
                'rows': 1,
                'placeholder': placeholder,
                'data-controller': 'submit-on-enter',
                'data-action': 'keydown->submit-on-enter#submit',
            }}) }}
            <button class="btn btn-ghost btn-circle {{ large ? '' : 'btn-sm' }} text-primary" aria-label="{{ submit_label }}">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
        {{ form_errors(field) }}
    </div>
</div>

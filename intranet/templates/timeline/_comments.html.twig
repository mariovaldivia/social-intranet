{# Comment thread of a post, oldest first. app.js appends new comments to
   .comments and loads the form into .comment-form. .comments is kept free of
   whitespace so `empty:hidden` hides its divider when there are no comments. #}
<div class="comments border-t border-base-200 mt-3 pt-1 empty:hidden">
    {%- for comment in post.comments -%}
        {%- include "timeline/_commentItem.html.twig" with {'comment': comment} -%}
    {%- endfor -%}
</div>

<div class="comment-form"></div>
